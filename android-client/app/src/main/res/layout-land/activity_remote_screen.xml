<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/screen_title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingLeft="6dp"
            android:paddingRight="8dp"
            android:text="Екран ПК"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/screen_monitor_spinner"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/edit_background"
            android:prompt="@string/monitor_prompt" />

        <Button
            android:id="@+id/screen_refresh"
            android:layout_width="82dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:background="@drawable/button_primary"
            android:text="Оновити"
            android:textColor="@color/text_primary"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/screen_frame_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="3"
            android:background="@drawable/touchpad_background">

            <ImageView
                android:id="@+id/screen_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:contentDescription="Знімок екрана ПК"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/screen_placeholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="10dp"
                android:text="Завантаження знімка…"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <Button
                android:id="@+id/screen_mode_left"
                style="@style/CoreMoreButtonPrimary"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="ЛКМ" />
            <Button
                android:id="@+id/screen_mode_double"
                style="@style/CoreMoreButton"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="2× ЛКМ" />
            <Button
                android:id="@+id/screen_mode_right"
                style="@style/CoreMoreButton"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="ПКМ" />
            <Button
                android:id="@+id/screen_auto"
                style="@style/CoreMoreButton"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="Авто: OFF" />
            <Button
                android:id="@+id/screen_touchpad"
                style="@style/CoreMoreButton"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="Тачпад" />
            <Button
                android:id="@+id/screen_close"
                style="@style/CoreMoreButton"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="Назад" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/screen_status"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="Підключення…"
        android:textColor="@color/text_secondary"
        android:textSize="9sp" />
</LinearLayout>
