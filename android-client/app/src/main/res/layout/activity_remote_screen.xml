<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="6dp">

    <TextView
        android:id="@+id/screen_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Екран ПК"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal">

        <Spinner
            android:id="@+id/screen_monitor_spinner"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/edit_background"
            android:prompt="@string/monitor_prompt" />

        <Button
            android:id="@+id/screen_refresh"
            android:layout_width="82dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:background="@drawable/button_primary"
            android:text="Оновити"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/screen_frame_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="3dp"
        android:layout_weight="1"
        android:background="@drawable/touchpad_background">

        <ImageView
            android:id="@+id/screen_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="Знімок екрана ПК"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/screen_placeholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="12dp"
            android:text="Завантаження знімка…"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/screen_mode_left"
            style="@style/CoreKeyPrimary"
            android:text="ЛКМ" />

        <Button
            android:id="@+id/screen_mode_double"
            style="@style/CoreKey"
            android:text="2× ЛКМ" />

        <Button
            android:id="@+id/screen_mode_right"
            style="@style/CoreKey"
            android:text="ПКМ" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/screen_auto"
            style="@style/CoreKey"
            android:text="Авто: OFF" />

        <Button
            android:id="@+id/screen_touchpad"
            style="@style/CoreKey"
            android:text="Тачпад" />

        <Button
            android:id="@+id/screen_close"
            style="@style/CoreKey"
            android:text="Назад" />
    </LinearLayout>

    <TextView
        android:id="@+id/screen_status"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="Підключення…"
        android:textColor="@color/text_secondary"
        android:textSize="9sp" />
</LinearLayout>
