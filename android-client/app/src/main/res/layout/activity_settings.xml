<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_version_label"
            android:textColor="@color/text_primary"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="LG P500 · Android 2.3+ · кілька ПК"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Збережені комп’ютери"
            android:textColor="@color/text_secondary" />

        <Spinner
            android:id="@+id/profile_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/new_profile_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/button_secondary"
                android:text="Новий ПК"
                android:textColor="@color/text_primary" />
            <Button
                android:id="@+id/delete_profile_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_weight="1"
                android:background="@drawable/button_secondary"
                android:text="Видалити"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Назва ПК"
            android:textColor="@color/text_secondary" />
        <EditText
            android:id="@+id/profile_name_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edit_background"
            android:hint="Lenovo"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="#738398" />

        <Button
            android:id="@+id/discover_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/button_primary"
            android:text="@string/discover_pc"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/server_address"
            android:textColor="@color/text_secondary" />
        <EditText
            android:id="@+id/host_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edit_background"
            android:hint="192.168.0.105"
            android:inputType="textUri"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="#738398" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/server_port"
            android:textColor="@color/text_secondary" />
        <EditText
            android:id="@+id/port_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edit_background"
            android:hint="8765"
            android:inputType="number"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="#738398" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Одноразове парування"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Створи код у вебредакторі ПК, введи його нижче й натисни «Парувати»."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
        <EditText
            android:id="@+id/pairing_code_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/edit_background"
            android:hint="123456"
            android:inputType="number"
            android:maxLength="6"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="#738398" />
        <Button
            android:id="@+id/pair_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/button_primary"
            android:text="@string/pair_device"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/access_token"
            android:textColor="@color/text_secondary" />
        <EditText
            android:id="@+id/token_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edit_background"
            android:inputType="textPassword"
            android:singleLine="true"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Wake-on-LAN"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/mac_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edit_background"
            android:hint="MAC: AA:BB:CC:DD:EE:FF"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="#738398" />
        <EditText
            android:id="@+id/broadcast_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="@drawable/edit_background"
            android:hint="255.255.255.255"
            android:inputType="textUri"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="#738398" />
        <Button
            android:id="@+id/wake_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/button_secondary"
            android:text="@string/wake_pc"
            android:textColor="@color/text_primary" />
        <Button
            android:id="@+id/wol_diagnostics_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="@drawable/button_secondary"
            android:text="Діагностика Wake-on-LAN"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Режим пристрою"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />
        <Spinner
            android:id="@+id/device_layout_spinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/edit_background"
            android:prompt="@string/device_layout_prompt" />
        <TextView
            android:id="@+id/device_layout_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:text="Авто визначає LG P500 або сучасний HD-смартфон."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Роль цього пристрою"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />
        <Spinner
            android:id="@+id/device_role_spinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/edit_background"
            android:prompt="@string/device_role_prompt" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:text="Стаціонарна панель економить батарею; мобільний пульт отримує швидший realtime-режим і більше кнопок."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Продуктивність і фонова робота"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />
        <CheckBox
            android:id="@+id/native_core_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/native_core_mode"
            android:textColor="@color/text_primary" />

        <CheckBox
            android:id="@+id/p500_lite_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Ultra Lite UI: швидша панель 320×480"
            android:textColor="@color/text_primary" />

        <CheckBox
            android:id="@+id/adaptive_runtime_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Adaptive Runtime: підлаштовувати мережу, батарею та RAM"
            android:textColor="@color/text_primary" />

        <CheckBox
            android:id="@+id/realtime_input_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Realtime-тачпад через WebSocket (HTTP як резерв)"
            android:textColor="@color/text_primary" />

        <CheckBox
            android:id="@+id/fullscreen_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/fullscreen"
            android:textColor="@color/text_primary" />
        <CheckBox
            android:id="@+id/screen_on_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/keep_screen_on"
            android:textColor="@color/text_primary" />
        <CheckBox
            android:id="@+id/reconnect_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auto_reconnect"
            android:textColor="@color/text_primary" />
        <CheckBox
            android:id="@+id/autostart_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auto_start"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Redmi / MIUI"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Для стабільного перепідключення дозволь автозапуск і роботу без обмеження батареї."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/open_autostart_button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="@drawable/button_secondary"
                android:text="Автозапуск"
                android:textColor="@color/text_primary" />
            <Button
                android:id="@+id/open_battery_button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="@drawable/button_secondary"
                android:text="Батарея"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Нативний пульт і фізичні кнопки"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/hardware_keys_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hardware_keys"
            android:textColor="@color/text_primary" />
        <CheckBox
            android:id="@+id/long_press_media_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/long_press_media"
            android:textColor="@color/text_primary" />
        <CheckBox
            android:id="@+id/haptic_feedback_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/haptic_feedback"
            android:textColor="@color/text_primary" />
        <CheckBox
            android:id="@+id/sound_feedback_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sound_feedback"
            android:textColor="@color/text_primary" />
        <CheckBox
            android:id="@+id/launcher_mode_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/launcher_mode"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Яскравість панелі, %"
            android:textColor="@color/text_secondary" />
        <EditText
            android:id="@+id/panel_brightness_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edit_background"
            android:hint="90"
            android:inputType="number"
            android:singleLine="true"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Яскравість після бездіяльності, %"
            android:textColor="@color/text_secondary" />
        <EditText
            android:id="@+id/idle_brightness_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edit_background"
            android:hint="20"
            android:inputType="number"
            android:singleLine="true"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Затемнення через, секунд (0 — вимкнено)"
            android:textColor="@color/text_secondary" />
        <EditText
            android:id="@+id/idle_timeout_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edit_background"
            android:hint="60"
            android:inputType="number"
            android:singleLine="true"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/open_native_remote_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/button_secondary"
            android:text="@string/open_native_remote"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/test_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/button_secondary"
            android:text="@string/test_connection"
            android:textColor="@color/text_primary" />
        <Button
            android:id="@+id/save_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/button_primary"
            android:text="@string/save_and_connect"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/diagnostics_title"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/diagnostics_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/edit_background"
            android:padding="10dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
        <Button
            android:id="@+id/export_diagnostics_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/button_secondary"
            android:text="@string/export_diagnostics"
            android:textColor="@color/text_primary" />
    </LinearLayout>
</ScrollView>
