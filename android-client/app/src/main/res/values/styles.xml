<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="CoreActionButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:background">@drawable/button_secondary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">2</item>
    </style>
    <style name="CoreKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:background">@drawable/button_secondary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">11sp</item>
    </style>
    <style name="CoreKeyPrimary" parent="@style/CoreKey">
        <item name="android:background">@drawable/button_primary</item>
    </style>
    <style name="CoreKeyDanger" parent="@style/CoreKey">
        <item name="android:background">@drawable/button_danger</item>
    </style>
    <style name="CoreMoreButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:background">@drawable/button_secondary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="CoreMoreButtonPrimary" parent="@style/CoreMoreButton">
        <item name="android:background">@drawable/button_primary</item>
    </style>
    <style name="CoreNavButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:background">@drawable/button_secondary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">9sp</item>
    </style>

    <style name="CoreYouTubeButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:background">@drawable/button_secondary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">10sp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">2</item>
    </style>
    <style name="CoreYouTubeButtonPrimary" parent="@style/CoreYouTubeButton">
        <item name="android:background">@drawable/button_youtube</item>
    </style>
    <style name="CoreNavButtonYoutube" parent="@style/CoreNavButton">
        <item name="android:background">@drawable/button_youtube</item>
    </style>

    <style name="CoreActionButtonModern" parent="@style/CoreActionButton">
        <item name="android:layout_margin">5dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:padding">6dp</item>
    </style>

    <style name="CoreMonitorRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:background">@drawable/button_secondary</item>
        <item name="android:padding">9dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="CoreMonitorBlock" parent="CoreMonitorRow">
        <item name="android:textSize">11sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

</resources>
